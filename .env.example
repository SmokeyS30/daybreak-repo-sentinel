NODE_ENV=development
HOST=127.0.0.1
PORT=3000
PUBLIC_BASE_URL=http://127.0.0.1:3000
DATA_DIR=./data

# Register a GitHub App, then copy these values from its settings page.
GITHUB_APP_ID=
GITHUB_APP_SLUG=daybreak-repo-sentinel
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=

# Use long random values. Existing encrypted data depends on DATA_ENCRYPTION_KEY.
SESSION_SECRET=
DATA_ENCRYPTION_KEY=

# Optional AI summaries. Deterministic monitoring works without this key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

SCAN_INTERVAL_MINUTES=15
MAX_REPOSITORIES_PER_SCAN=250
PUBLIC_METRICS=true
AUTO_PUBLISH_ISSUES=false
